{
  "title": "Limits",
  "formulas": [
    {
      "name": "Constant Law",
      "formula": "\\lim_{x \\to a} c = c"
    },
    {
      "name": "Identity Law",
      "formula": "\\lim_{x \\to a} x = a"
    },
    {
      "name": "Sum Law",
      "formula": "\\lim_{x \\to a} [f(x) + g(x)] = L + M"
    },
    {
      "name": "Difference Law",
      "formula": "\\lim_{x \\to a} [f(x) - g(x)] = L - M"
    },
    {
      "name": "Product Law",
      "formula": "\\lim_{x \\to a} [f(x)g(x)] = LM"
    },
    {
      "name": "Quotient Law",
      "formula": "\\lim_{x \\to a} \\frac{f(x)}{g(x)} = \\frac{L}{M}"
    },
    {
      "name": "Power Law",
      "formula": "\\lim_{x \\to a} [f(x)]^n = L^n"
    }
  ]
}