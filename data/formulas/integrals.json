{
  "title": "Integrals",
  "formulas": [
    {
      "name": "Power Rule",
      "formula": "\\int x^n \\, dx = \\frac{x^{n+1}}{n+1} + C, \\quad n \\neq -1"
    },
    {
      "name": "Constant Rule",
      "formula": "\\int c \\, dx = cx + C"
    },
    {
      "name": "Sum Rule",
      "formula": "\\int [f(x)+g(x)] \\, dx = \\int f(x) \\, dx + \\int g(x) \\, dx"
    },
    {
      "name": "Difference Rule",
      "formula": "\\int [f(x)-g(x)] \\, dx = \\int f(x) \\, dx - \\int g(x) \\, dx"
    },
    {
      "name": "Constant Multiple Rule",
      "formula": "\\int cf(x) \\, dx = c\\int f(x) \\, dx"
    }
  ]
}